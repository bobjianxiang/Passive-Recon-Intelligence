# Copy this file to .env and replace these with your own database username and password.
# Keep DATABASE_URL's username and password in sync with POSTGRES_USER and POSTGRES_PASSWORD.
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=passive_recon
DATABASE_URL=postgresql+asyncpg://your_username:your_password@db:5432/passive_recon
APP_ENV=development
